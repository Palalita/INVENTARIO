# Puerto donde escucha el servidor Express
PORT=4000

# development | production | test
NODE_ENV=development

# Cadena de conexión de PostgreSQL usada por Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Origen permitido por CORS (frontend Next.js)
FRONTEND_URL=http://localhost:3000

# Secreto para firmar los JWT de access token (openssl rand -hex 32)
JWT_ACCESS_SECRET=changeme_access_secret

# Secreto usado para el hashing/HMAC de refresh tokens (openssl rand -hex 32)
REFRESH_TOKEN_SECRET=changeme_refresh_secret

# Password del usuario admin creado por el seed (opcional, default Admin123!)
ADMIN_SEED_PASSWORD=Admin123!

# Porcentaje de impuesto aplicado a las facturas (opcional, default 0.12 = 12%)
TAX_RATE=0.12

# Imágenes de producto — Cloudflare R2 (API S3-compatible). Opcionales: sin
# estas variables, el endpoint de subida de imágenes responde un error claro
# en vez de romper el arranque del servidor.
# Account ID: panel de Cloudflare, vista general de R2.
R2_ACCOUNT_ID=
# R2 -> Manage API Tokens -> Create API Token (permiso Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre exacto del bucket creado en R2
R2_BUCKET_NAME=
# URL pública del bucket (R2.dev subdomain o dominio propio), sin / al final
R2_PUBLIC_URL=
